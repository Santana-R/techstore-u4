  "paths": {
    "/orders/{order_id}": {
      "get": {
        "tags": [
          "Órdenes"
        ],
        "summary": "Consultar una orden",
        "operationId": "get_order_orders__order_id__get",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Orden o producto no encontrado",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Orden no existe."
              }
            }
          },
          "409": {
            "description": "La operación no se puede realizar en el estado actual",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "La orden ya está confirmada. No se puede confirmar otra vez."
              }
            }
          },
          "422": {
            "description": "Falta un dato o no se cumple una condición de la orden",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "No se puede confirmar una orden vacía. Agrega al menos un producto."
              }
            }
          }
        }
      }
    },
