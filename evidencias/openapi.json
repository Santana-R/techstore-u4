  "components": {
    "schemas": {
      "CancelBody": {
        "properties": {
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Motivo de la cancelación. No debe estar vacío.",
            "examples": [
              "Solicitud del cliente"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "CancelBody"
      },
      "ItemBody": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku",
            "description": "Código del producto en el catálogo.",
            "examples": [
              "SKU003"
            ]
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "description": "Cantidad entera mayor que cero.",
            "examples": [
              2
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "ItemBody"
      },
      "ShipBody": {
        "properties": {
          "tracking_number": {
            "type": "string",
            "title": "Tracking Number",
            "description": "Número de guía del envío. No debe estar vacío.",
            "examples": [
              "GUIA-U4-001"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tracking_number"
        ],
        "title": "ShipBody"
      }
