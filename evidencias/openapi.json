          },
          "total": {
            "type": "string",
            "title": "Total"
          },
          "discount_percent": {
            "type": "string",
            "title": "Discount Percent"
          },
          "discount": {
            "type": "string",
            "title": "Discount"
          },
          "payable": {
            "type": "string",
            "title": "Payable"
          },
