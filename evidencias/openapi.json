            "type": "string",
            "title": "Order Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "total": {
            "type": "string",
            "title": "Total"
          },
          "occurred_at": {
            "type": "string",
            "title": "Occurred At"
          },
          "tracking_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tracking Number"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "name",
          "order_id",
          "customer_id",
          "total",
          "occurred_at",
          "tracking_number",
          "reason"
        ],
        "title": "EventView"
      },
