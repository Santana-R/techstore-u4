        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku",
            "examples": [
              "SKU003"
            ]
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "examples": [
              2
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "ItemBody"
      },
      "ItemView": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "string",
            "title": "Unit Price"
          },
